{
    "mcpServers": {
        "browsermcp": {
            "command": "npx",
            "args": [
                "-y",
                "@browsermcp/mcp@latest"
            ]
        },
        "mysql": {
            "command": "npx",
            "args": [
                "-y",
                "mysql-mcp-server"
            ],
            "env": {
                "MYSQL_HOST": "127.0.0.1",
                "MYSQL_PORT": "3306",
                "MYSQL_USER": "root",
                "MYSQL_PASSWORD": "",
                "MYSQL_DATABASE": "sollu_old"
            }
        },
        "sollu-db": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-postgres",
                "postgresql://whykrr@127.0.0.1:5432/sollu_core"
            ]
        },
        "laravel-boost": {
            "command": "php",
            "args": [
                "/Users/whykrr/Documents/Projects/Laravel/sollu-app/artisan",
                "boost:mcp"
            ]
        },
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "/Users/whykrr/Documents/Projects/Laravel/sollu-app"
            ]
        },
        "git": {
            "command": "npx",
            "args": [
                "-y",
                "git-mcp-server"
            ],
            "env": {
                "GIT_DEFAULT_PATH": "/Users/whykrr/Documents/Projects/Laravel/sollu-app"
            }
        }
    }
}
