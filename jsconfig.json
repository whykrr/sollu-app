{
    "compilerOptions": {
        "jsx": "preserve",
        "allowImportingTsExtensions": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [ "resources/js/*" ]
        }
    },
    "include": [
        "resources/js/**/*" // Include all JavaScript files
    ],
    "exclude": [ "node_modules", "**/node_modules/*" ]
}
