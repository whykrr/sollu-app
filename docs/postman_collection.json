						"body": {
							"mode": "raw",
							"raw": "{\n    \"offline_id\": \"9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d\",\n    \"receipt_number\": \"INV/20260810/0001\",\n    \"customer_id\": null,\n    \"subtotal\": 50000,\n    \"discount_amount\": 5000,\n    \"tax_amount\": 4950,\n    \"service_charge_amount\": 0,\n    \"total\": 49950,\n    \"payment_status\": \"paid\",\n    \"status\": \"completed\",\n    \"notes\": \"Catatan pesanan\",\n    \"items\": [\n        {\n            \"product_id\": \"018f2d5e-7a1b-7a2c-9a3d-4e5f6a7b8c9d\",\n            \"variant_group_option_id\": null,\n            \"product_name\": \"Kopi Susu Gula Aren\",\n            \"price\": 25000,\n            \"qty\": 2,\n            \"discount_amount\": 0,\n            \"subtotal\": 50000,\n            \"modifiers\": [\n                {\n                    \"modifier_option_id\": \"018f2d5e-8b2c-8b3d-a4e5-5f6a7b8c9d0e\",\n                    \"modifier_name\": \"Extra Shot\",\n                    \"price\": 5000,\n                    \"qty\": 1\n                }\n            ]\n        }\n    ],\n    \"payments\": [\n        {\n            \"payment_method_id\": \"018f2d5e-9c3d-9c4e-b5f6-6a7b8c9d0e1f\",\n            \"amount\": 50000,\n            \"change_amount\": 50,\n            \"payment_reference\": \"CASH-001\"\n        }\n    ]\n}"
