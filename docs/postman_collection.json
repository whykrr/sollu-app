{
	"info": {
		"_postman_id": "a3b4c5d6-7890-4123-b456-7890abcdef12",
		"name": "Sollu POS Client API",
		"description": "Koleksi Postman Siap Import untuk Pengujian API POS Client & Pairing Perangkat Sollu App.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000/api/pos",
			"type": "string"
		},
		{
			"key": "deviceToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Device Pairing",
			"item": [
				{
					"name": "Verify OTP & Pair Device",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('deviceToken', jsonData.data.token);",
									"    console.log('deviceToken updated:', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"otp\": \"12345678\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/device/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"device",
								"verify-otp"
							]
						},
						"description": "Verifikasi 8-digit OTP dari Dashboard untuk menghubungkan perangkat POS dan mengeset otomatis {{deviceToken}}."
					},
					"response": []
				}
			]
		},
		{
			"name": "Master Data & Sync",
			"item": [
				{
					"name": "Pull Master Data",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{deviceToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/sync/master",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"sync",
								"master"
							]
						},
						"description": "Menarik seluruh master data (Produk, Kategori, Metode Pembayaran, Setting Tax) untuk disimpan di SQLite POS."
					},
					"response": []
				}
			]
		},
		{
