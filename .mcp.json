    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": ["artisan", "boost:mcp"]
        },
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "/Users/whykrr/Documents/Projects/Laravel/sollu-app"
            ]
        },
        "git-core": {
            "command": "npx",
            "args": ["-y", "git-mcp-server"],
            "env": {
                "GIT_DEFAULT_PATH": "/Users/whykrr/Documents/Projects/Laravel/sollu-app"
            }
        }
    }
}
